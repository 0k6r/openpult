        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Входы и питание"
          }
        }
      }
    },
    "Insert the batteries and turn on the bridge with its switch." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте батарейки и включите приставку выключателем."
          }
        }
      }
    },
    "Installed on" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дата установки"
          }
        }
      }
    },
    "iOS hasn't allowed OpenPult to access the local network. Allow it in Settings and search again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не дал «Пульту» доступ к локальной сети. Разрешите его в настройках и повторите поиск."
          }
